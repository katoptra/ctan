# This file contains only op:// references. `op run --env-file=op.env` gets their values
# at run time. The secrets are in one vault, addressed by UUID. Thus, the references stay
# correct when the vault gets a new name. The item is ctan. Refer to katoptra/lib, Secrets.
AWS_ACCESS_KEY_ID=op://y6y6b6l2zjbpv7szc5ym5sprne/ctan/r2/access_key_id
AWS_SECRET_ACCESS_KEY=op://y6y6b6l2zjbpv7szc5ym5sprne/ctan/r2/secret_access_key
AWS_ENDPOINT_URL=op://y6y6b6l2zjbpv7szc5ym5sprne/ctan/r2/endpoint
HEALTHCHECK_URL=op://y6y6b6l2zjbpv7szc5ym5sprne/ctan/healthcheck/url
